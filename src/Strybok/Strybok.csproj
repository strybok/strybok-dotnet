<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Strybok</RootNamespace>
    <AssemblyName>Strybok</AssemblyName>
    <Version>0.1.0</Version>
    <Description>Strybok deep-link SDK for .NET: resolves Universal Links / App Links to an in-app route and delivers each link exactly once.</Description>
    <IsPackable>true</IsPackable>
    <PackageId>Strybok</PackageId>
    <Authors>Strybok</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://strybok.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/strybok/strybok-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>deep-linking;universal-links;app-links;maui</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- Modern targets have System.Text.Json and IAsyncDisposable in the framework. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
  </ItemGroup>

</Project>
