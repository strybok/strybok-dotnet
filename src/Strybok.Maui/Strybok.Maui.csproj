<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Plain net8.0 on purpose: the glue only needs DeviceInfo (Microsoft.Maui.Essentials) and the
    DI abstractions, so it builds without the MAUI workload and can be referenced from
    net8.0/net9.0/net10.0 -android and -ios apps. The app's own MAUI version wins at restore.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Strybok.Maui</RootNamespace>
    <AssemblyName>Strybok.Maui</AssemblyName>
    <Version>0.4.0</Version>
    <Description>.NET MAUI glue for the Strybok deep-link SDK: registers the SDK in dependency injection and reports the device platform.</Description>
    <IsPackable>true</IsPackable>
    <PackageId>Strybok.Maui</PackageId>
    <Authors>Strybok</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://strybok.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/strybok/strybok-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>deep-linking;universal-links;app-links;maui</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Essentials" Version="8.0.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Strybok\Strybok.csproj" />
  </ItemGroup>

</Project>
